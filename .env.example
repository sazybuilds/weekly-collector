# ============================================================
# Environment Variables for Weekly Orders Collector
# ============================================================
# Copy this file to .env for local testing (it is already in .gitignore).
# In production:
#  - Streamlit Community Cloud: enter these in App Settings > Secrets
#  - GitHub Actions: enter these in Repository Settings > Secrets > Actions

# 1. Supabase PostgreSQL Connection String (Pooler URI, session mode port 6543 or 5432)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Fernet Encryption Key (44 characters ending in '=')
# Generate using: python scripts/generate_keys.py
ENCRYPTION_KEY=dYkyCUTuNn8R6E9UbwmEVaU4NjGlVOrEAvnsR68Zhoo=

# 3. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenText

# 4. Telegram Chat ID (from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=123456789

# 5. Optional: Secret API Key between Streamlit and FastAPI (if running api/main.py)
API_KEY=x4iSiN-UvQ3xFjYBFr239YUXqJ7PYnSxf84Vwsq4b50
