# Template for Streamlit Secrets
# Copy this file to streamlit_app/.streamlit/secrets.toml for local testing
# In production on Streamlit Community Cloud: paste these into App Settings > Secrets

# OPTION 1 (RECOMMENDED - Direct Supabase Database Connection):
# Get the connection string from Supabase Dashboard: Project Settings > Database > Connection string > URI (select "Pooler" / Mode: Session or Transaction, port 6543)
DATABASE_URL = "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Generated with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY = "your-44-character-fernet-key-ending-in-="

# OPTION 2 (ALTERNATIVE - Supabase REST API):
# SUPABASE_URL = "https://your-project-id.supabase.co"
# SUPABASE_KEY = "your-anon-key-or-service-role-key"
# ENCRYPTION_KEY = "your-44-character-fernet-key-ending-in-="

# OPTION 3 (OPTIONAL - If running FastAPI api/main.py):
# API_URL = "http://127.0.0.1:8000"
# API_KEY = "your-secret-api-key"
